# Local provider plugin cache. Recreated by `terraform init`.
.terraform/

# Plan files. Sometimes useful to share, usually not.
*.tfplan
tfplan

# State files. NEVER commit these — they can contain secrets in plaintext.
# Even for this local-only tutorial, treat them as gitignored on principle.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files often contain secrets or environment-specific values.
*.tfvars
*.tfvars.json
!example.tfvars      # but allow example files if you add them

# Crash logs Terraform produces on errors.
crash.log
crash.*.log

# CLI configuration / credentials.
.terraformrc
terraform.rc

# Files generated by tutorial exercises. The exercises write these and the
# user is supposed to recreate them — no value in checking them in.
**/hello.txt
**/greeting.txt
**/greeting-*.txt
**/input.txt
**/output.txt
**/managed.txt
**/rendered.txt
**/info.txt
**/all_uppercase.txt
**/config.json
**/greeting.tftpl
**/file-*.txt
**/apple.txt
**/banana.txt
**/cherry.txt
**/world-greeting.txt
**/terraform-greeting.txt
**/alpha.txt
**/beta.txt
**/gamma.txt
**/delta.txt

# Web app build artifacts (the SPA in app/ — see Makefile / Dockerfile).
app/node_modules/
app/dist/
app/.vite/
app/coverage/

# macOS noise.
.DS_Store

# Editor noise.
.vscode/
.idea/
*.swp
*~

# DO commit:
#   .terraform.lock.hcl   — pins provider versions for reproducibility
